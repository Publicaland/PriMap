<StatusMessage Message="@StatusMessage" />
<h3>Coduri de recuperare</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <strong>Plasați aceste coduri într-un loc sigur.</strong>
    </p>
    <p>
        Dacă îți pierzi dispozitivul și nu ai codurile de recuperare, vei pierde accesul la contul tău.
    </p>
</div>
<div class="row">
    <div class="col-md-12">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <div>
                <code class="recovery-code">@recoveryCode</code>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
